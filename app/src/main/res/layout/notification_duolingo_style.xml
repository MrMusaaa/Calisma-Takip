<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duo_notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/duo_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Mascot & Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/duo_notif_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🦉 MESAİ TAKİP"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/duo_notif_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="BOŞTA"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Headline and Subtitle -->
    <TextView
        android:id="@+id/duo_notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="💪 Yeni vardiyaya hazır mısın?"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/duo_notif_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="⚡ Başlamak için dokun • Salı: Maaş Günü"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <!-- Duolingo Style 3D Action Button -->
    <Button
        android:id="@+id/duo_notif_btn"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/duo_btn_start"
        android:text="▶ MESAİYİ BAŞLAT"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
